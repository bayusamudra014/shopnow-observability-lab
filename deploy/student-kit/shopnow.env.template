# ShopNow: how to run on THIS machine. Fill in, then run the deploy script.
#
#   MODE=local   a student computer (Ubuntu desktop or Windows). Everything runs here,
#                including the payment provider (MockPay). Open http://shop.localhost
#   MODE=vm      a server reached over the network (DNS). Payments go to the course
#                payment provider, which calls this VM back.
MODE=__MODE__

# --- Hostnames of the shop, Mailpit and SigNoz.
#     MODE=local: leave empty for shop.localhost, mail.shop.localhost, signoz.shop.localhost
#                 (browsers resolve *.localhost by themselves, no hosts file needed).
#     MODE=vm:    required; DNS must point them at this VM.
SHOP_HOST=
MAIL_HOST=
SIGNOZ_HOST=
# Port on this machine that serves them (use e.g. 8080 if 80 is taken; MODE=vm: keep 80).
# It is fixed when the cluster is first created: change it only after ./destroy.
HTTP_PORT=80
# Address opened in the browser. MODE=local: leave empty (derived from SHOP_HOST/HTTP_PORT).
SHOP_PUBLIC_URL=

# --- MODE=local only: port of the local MockPay console (http://localhost:<port>/admin).
MOCKPAY_PORT=8090

# --- MODE=vm only: the course payment provider, and where it calls this VM back,
#     e.g. <SHOP_PUBLIC_URL>/webhooks/payment-provider. (MODE=local runs its own MockPay.)
PROVIDER_URL=
WEBHOOK_CALLBACK_URL=

# Shared with the course payment provider and traffic generator (prefilled by the release).
PROVIDER_API_KEY=__PROVIDER_API_KEY__
PROVIDER_WEBHOOK_SECRET=__PROVIDER_WEBHOOK_SECRET__
SEED_USER_PASSWORD=__SEED_USER_PASSWORD__
