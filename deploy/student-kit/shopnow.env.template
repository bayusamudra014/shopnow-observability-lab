# ShopNow: settings for THIS VM. Fill in every empty value, then run ./deploy.sh
#
# Public hostnames of this VM (DNS must point them at this VM; ports 80/443).
SHOP_HOST=
MAIL_HOST=
SIGNOZ_HOST=
# Address students open in the browser, e.g. http://<SHOP_HOST>
SHOP_PUBLIC_URL=

# Payment provider (MockPay) the shop charges, e.g. http://<provider host>
PROVIDER_URL=
# Where the provider sends this shop's payment results; must reach this VM's /webhooks,
# e.g. <SHOP_PUBLIC_URL>/webhooks/payment-provider
WEBHOOK_CALLBACK_URL=

# Shared with the payment provider and the traffic generator (prefilled by the release).
PROVIDER_API_KEY=__PROVIDER_API_KEY__
PROVIDER_WEBHOOK_SECRET=__PROVIDER_WEBHOOK_SECRET__
SEED_USER_PASSWORD=__SEED_USER_PASSWORD__
