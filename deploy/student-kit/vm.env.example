# Per-VM settings for scripts\render-student-kit.ps1 -VmEnvFile <this file>.
# Copy it once per VM (e.g. vms\node1.env, vms\node2.env); the file name names the kit.
# Hosts must resolve (DNS) to that VM; ports 80/443 open.

SHOP_HOST=shop.example.com
MAIL_HOST=mail.shop.example.com
SIGNOZ_HOST=signoz.shop.example.com
SHOP_PUBLIC_URL=http://shop.example.com

# The payment provider (MockPay on the instructor host) and where it calls this VM back.
PROVIDER_URL=http://payment.example.com
WEBHOOK_CALLBACK_URL=http://shop.example.com/webhooks/payment-provider
