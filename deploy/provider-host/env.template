# ShopNow instructor host: MockPay + traffic generator. Fill in the empty values, then ./deploy.sh

# Webhooks: host suffixes shops may ask MockPay to call back (comma-separated, e.g. .example.com).
# Empty = any host.
WEBHOOK_ALLOWED_HOSTS=
# Fallback webhook URL for charges that do not carry one (optional).
WEBHOOK_URL=

# Traffic generator targets on first start: comma-separated shop API base URLs,
# e.g. http://<vm1 host>/api,http://<vm2 host>/api   (later: edit them in the UI)
TARGET_BASE_URLS=
# Start generating traffic immediately (true) or wait for Start in the UI (false).
AUTOSTART=false

# Ports and bind addresses on this host. GENERATOR_BIND=127.0.0.1 keeps the generator
# reachable only through an SSH tunnel.
PROVIDER_PORT=80
PROVIDER_BIND=0.0.0.0
GENERATOR_PORT=8091
GENERATOR_BIND=0.0.0.0

# Release values and shared secrets (prefilled by scripts/release.ps1; keep in sync with the student kits).
REGISTRY=__REGISTRY__
TAG=__TAG__
PROVIDER_API_KEY=__PROVIDER_API_KEY__
PROVIDER_WEBHOOK_SECRET=__PROVIDER_WEBHOOK_SECRET__
PROVIDER_ADMIN_TOKEN=__PROVIDER_ADMIN_TOKEN__
PROVIDER_DB_PASSWORD=__PROVIDER_DB_PASSWORD__
SEED_USER_PASSWORD=__SEED_USER_PASSWORD__
CONTROL_TOKEN=__CONTROL_TOKEN__
