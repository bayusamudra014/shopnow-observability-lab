# Copy to .env (scripts/deploy.ps1 generates it with random values automatically).
# PROVIDER_API_KEY and PROVIDER_WEBHOOK_SECRET must match the shop-secrets in minikube.
PROVIDER_DB_PASSWORD=change-me
PROVIDER_API_KEY=change-me
PROVIDER_WEBHOOK_SECRET=change-me
# Optional: leave empty to get a generated token in the logs on first start
PROVIDER_ADMIN_TOKEN=

# Addresses on the Docker "minikube" network
MINIKUBE_IP=192.168.49.2
PROVIDER_IP=192.168.49.100

# Optional default chaos
# CHAOS_LATENCY_MS=80
# CHAOS_DECLINE_RATE=0.03
# CHAOS_WEBHOOK_DELAY_MS=2000
