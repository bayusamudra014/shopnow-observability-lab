# Copy to .env (scripts/deploy.ps1 generates it automatically).
# SEED_USER_PASSWORD must match shop-secrets of the local deployment;
# PROVIDER_ADMIN_TOKEN must match the local payment provider.
CONTROL_TOKEN=change-me
SEED_USER_PASSWORD=change-me
PROVIDER_ADMIN_TOKEN=change-me

MINIKUBE_IP=192.168.49.2
PROVIDER_IP=192.168.49.100

# Initial traffic shape (adjustable later in http://localhost:8091)
PROFILE=steady
BASE_RATE=2
AUTOSTART=true
