{
  "name": "@shop/telemetry",
  "version": "1.0.0",
  "private": true,
  "description": "Shared OpenTelemetry bootstrap, logger, HTTP server, Postgres, Kafka and outbox helpers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "fastify": "^5.12.8",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/pg": "^8.15.6"
  }
}
